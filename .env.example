# Copy to .env.local for local development. Never commit real values.
# In the cloud, these come from each cloud's secret manager via Terraform.

APP_NAME="30 Apps Template"
APP_URL=http://localhost:3000

DATABASE_URL=postgres://app:app@localhost:5432/app

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# demo | gemini | anthropic
AI_PROVIDER=demo
AI_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_FALLBACK_TO_DEMO=true
# Embedding model for embed() (default gemini-embedding-2) and the timeout for every model call
AI_EMBED_MODEL=
AI_TIMEOUT_MS=20000

LOG_LEVEL=info

# Only for apps that store secrets (see README, "Encrypting stored secrets"). Generate with: openssl rand -base64 32
# TOKEN_ENC_KEY_PREVIOUS is set only while rotating.
TOKEN_ENC_KEY=
TOKEN_ENC_KEY_PREVIOUS=

# Apply pending migrations when the server starts (used in the cloud)
MIGRATE_ON_START=false

# Optional, used by `pnpm db:seed` against a running app
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Price refresh (Cloud Scheduler bearer token, `openssl rand -hex 32`) and the Google Cloud Billing Catalog API key
COST_SCALER_REFRESH_TOKEN=
COST_SCALER_GCP_PRICING_API_KEY=

# Cost Scaler advisor budget: the shared Gemini key's free daily request allowance (set the real figure; 200 is a low
# placeholder) and the share of it the advisor may use. The key's project must have no billing linked.
GEMINI_DAILY_REQUESTS=200
ADVISOR_GEMINI_SHARE=0.25
